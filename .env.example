# ============================================================
# TBE PEDIDOS - PRODUCCION
# ============================================================
PORT=3000
NODE_ENV=production

# Zona horaria usada para los cierres diarios automaticos
BUSINESS_TIMEZONE=America/Argentina/Buenos_Aires

# URL publica del servicio. En Render puede omitirse porque se usa
# RENDER_EXTERNAL_URL automaticamente. Ejemplo:
# PUBLIC_BASE_URL=https://tbe-pedidos.onrender.com
PUBLIC_BASE_URL=

# Clave privada para que solamente las tablets autorizadas puedan
# cargar/modificar pedidos, productos, categorias y consultar Caja.
# Usar una clave larga y distinta del token de WhatsApp.
TBE_ADMIN_KEY=

# WhatsApp Business Platform / Cloud API (Meta)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Version de Graph API. Mantenerla configurable para poder actualizarla
# cuando Meta cambie la version usada por la cuenta.
META_GRAPH_VERSION=v26.0

# En produccion debe quedar false. El simulador queda disponible solo
# si se cambia explicitamente a true.
ENABLE_SIMULATOR=false

# Directorio persistente. En Render el render.yaml monta un disco aqui.
DATA_DIR=/var/data
